# CAF (Code Aurora Forum) Qualcomm platform defconfig for SM7435
# This enables all CAF/Qualcomm platform support for ruan and dizi

# === CAF Platform Core ===
CONFIG_ARCH_QCOM_CAF=y

# === Shared Memory and IPC ===
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMEM_SDP=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GENI_SMEM_IPC=y

# === SPMI Power Management ===
CONFIG_QCOM_SPMI_PMIC=y
CONFIG_QCOM_SPMI_ADSP=y
CONFIG_QCOM_SPMI_PMIC_ARB=y
CONFIG_QCOM_SPMI_WRAPPER=y

# === PDC ===
CONFIG_QCOM_PDC=y

# === RPMH Power Management ===
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMH_ADSP=y
CONFIG_QCOM_RPMT=y
CONFIG_QCOM_RPMH_VS=y

# === CPR ===
CONFIG_QCOM_CPR=y

# === LLCC ===
CONFIG_QCOM_LLCC=y

# === QCOM Power ===
CONFIG_QCOM_POWER=y
CONFIG_QCOM_WATCHDOG=y

# === Clock Control ===
CONFIG_QCOM_CLOCK_OMNI_POCR=y
CONFIG_QCOM_CLOCK_RPMH_CXO=y
CONFIG_QCOM_CLOCK_VIBRATOR=n

# === Interconnect ===
CONFIG_QCOM_ICC_QCOM=y
CONFIG_QCOM_ICC_RPMH=y

# === GPIO and Pin Control ===
CONFIG_PINCTRL_QCOM=y
CONFIG_GPIO_QCOM=y

# === QUPV3 I2C ===
CONFIG_QCOM_QUPV3_I2C=y

# === USB PHYs ===
CONFIG_QCOM_USB_HSIC_PHY=n
CONFIG_QCOM_USB_HS_PHY=n
CONFIG_QCOM_USB_SS_PHY=n

# === CAF Audio ===
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_ADSP=y
CONFIG_SND_SOC_QCOM_WCD=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_QCOM_QDSP6APSS=n
CONFIG_MFD_QCOM_SPMI_PMIC=n

# === CAF Camera ===
CONFIG_CAMSS_QCOM=y
CONFIG_QCOM_CAMSS=y
CONFIG_QCOM_CAMERA_SENSOR=y

# === CAF Display ===
CONFIG_MSM_DISPLAY=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_HDMI=n

# === Debug ===
CONFIG_CAF_DEBUG=n