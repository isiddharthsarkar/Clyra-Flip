# Build config for Xiaomi dizi (SM7435 WiFi) — Android 16 / GKI 3.1 / kernel 6.6
# Produces a kernel + vendor modules compatible with Android 16 HyperOS and AOSP.

export COMMON_ANDROID_VERSION=16
export GKI_VERSION=3.1
export DEVICE=dizi
export MSM_ARCH=parrot

# Configs: base GKI -> platform (parrot) -> device (dizi) -> Android version fragment -> debugfs
# Paths are relative to arch/arm64/configs/ as required by kbuild defconfig handling.
export CONFIG_FILES="\
    gki_defconfig \
    vendor/parrot_GKI.config \
    vendor/dizi_GKI.config \
    vendor/dizi_android16.config \
    vendor/debugfs.config"

# Build both first-stage and vendor_dlkm module sets so HyperOS and AOSP
# vendor ramdisks can load them.
export BUILD_VENDOR_DLKM=1
export DT_OVERLAY_SUPPORT=1

# Targets
export MAKE_GOALS="Image modules dtbs"
