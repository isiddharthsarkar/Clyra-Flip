	bool "QCOM SPMI wrapper"
	depends on QCOM_SPMI_PMIC
	default y
	help
	  SPMI wrapper driver.

config QCOM_PDC
	tristate "QCOM Power Debug Controller"
	depends on ARCH_QCOM_CAF
	default y
	help
	  Power Debug Controller for Qualcomm power domain debugging.

config QCOM_RPMH
	tristate "QCOM Runtime Power Management Hierarchy"
	depends on ARCH_QCOM_CAF
	default y
	select QCOM_RPMT
	help
	  RPMH driver for Qualcomm runtime power management.

config QCOM_RPMH_ADSP
	bool "QCOM RPMH ADSP"
	depends on QCOM_RPMH
	default y
	help
	  RPMH driver for ADSP power management.

config QCOM_RPMT
	bool "QCOM RPM Timer"
	depends on ARCH_QCOM_CAF
	default y
	help
	  RPM Timer driver for Qualcomm SoCs.

config QCOM_RPMH_VS
	bool "QCOM RPMH voltage scaling"
	depends on QCOM_RPMH
	default y
	help
	  RPMH voltage/frequency scaling support.

config QCOM_CPR
	tristate "QCOM Critical Path Regression"
	depends on ARCH_QCOM_CAF
	default y
	help
	  CPR driver for critical path regression monitoring.

config QCOM_LLCC
	tristate "QCOM Last Level Cache Coherency"
	depends on ARCH_QCOM_CAF
	default y
	help
	  LLCC driver for last level cache coherency management.

config QCOM_POWER
	bool "QCOM Power management"
	depends on ARCH_QCOM_CAF
	default y
	help
	  QCOM power management framework.

config QCOM_WATCHDOG
	bool "QCOM Watchdog timer"
	depends on ARCH_QCOM_CAF
	default y
	help
	  Qualcomm watchdog timer driver.

endmenu # CAF Power Management

