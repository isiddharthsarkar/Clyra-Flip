	bool "QCOM SMEM state"
	depends on QCOM_SMEM
	default y
	help
	  SMEM state tracking.

config QCOM_SMEM_SDP
	bool "QCOM SMEM SDP"
	depends on QCOM_SMEM
	default y
	help
	  SMEM Secure Data Path.

