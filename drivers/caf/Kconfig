menu "CAF Shared Memory and IPC"

config QCOM_SMEM
	tristate "QCOM Shared Memory (SMEM)"
	depends on ARCH_QCOM_CAF
	default y
	help
	  QCOM Shared Memory driver for inter-processor communication.

