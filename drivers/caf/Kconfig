# Code Aurora Forum (CAF) / Qualcomm platform support
#

menu "Code Aurora Forum (CAF) Qualcomm platform support"

config ARCH_QCOM_CAF
	bool "CAF Qualcomm platform support (SM7435 / parrot)"
	depends on ARM64 && OF
	select QCOM_SMEM
	select QCOM_SMEM_STATE
	select QCOM_SMEM_SDP
	select QCOM_SMD_RPM
	select QCOM_RMTFS_MEM
	select QCOM_PDC
	select QCOM_SPMI_PMIC
	select QCOM_SPMI_ADSP
	select QCOM_SPMI_PMIC_ARB
	select QCOM_SPMI_WRAPPER
	select QCOM_GENI_SE
	select QCOM_GENI_SMEM_IPC
	select QCOM_RPMH
	select QCOM_RPMH_ADSP
	select QCOM_RPMT
	select QCOM_CPR
	select QCOM_LLCC
	select QCOM_QUPV3_I2C
	select QCOM_USB_HSIC_PHY
	select QCOM_USB_HS_PHY
	select QCOM_USB_SS_PHY
	select QCOM_CLOCK_OMNI_POCR
	select QCOM_CLOCK_RPMH_CXO
	select QCOM_CLOCK_VIBRATOR
	select PINCTRL_QCOM
	select GPIO_QCOM
	select QCOM_POWER
	select QCOM_WATCHDOG
	select QCOM_RPMH_VS
	select QCOM_ICC_QCOM
	select QCOM_ICC_RPMH
	help
	  CAF (Code Aurora Forum) Qualcomm platform support for SM7435
	  (parrot) SoC used by Xiaomi ruan and dizi devices.

	  This enables the core Qualcomm platform infrastructure required
	  for CAF-based device trees, power management, interconnect,
	  clock control, GPIO, pin control, and shared memory.

	  Say Y if building for Xiaomi ruan/dizi devices with stock
	  HyperOS or CAF-based firmware.

if ARCH_QCOM_CAF

# ---------------------------------------------------------------
# CAF Audio subsystem
# ---------------------------------------------------------------

menu "CAF Audio"

config SND_SOC_QCOM
	tristate "CAF Qualcomm SoC Audio support"
	depends on ARCH_QCOM_CAF && SND_SOC
	select QCOM_QDSP6APSS
	select QCOM_SMD_RPM
	select QCOM_RPMT
	select MFD_QCOM_SPMI_PMIC
	help
	  CAF audio support for Qualcomm SoCs including ADSP, WCD,
	  and audio codec drivers for SM7435.

config SND_SOC_QCOM_ADSP
	bool "CAF QDSP6 ADSP audio processor"
	depends on SND_SOC_QCOM
	default y
	help
	  Qualcomm QDSP6 audio digital signal processor support.

config SND_SOC_QCOM_WCD
	bool "CAF WCD audio codec"
	depends on SND_SOC_QCOM
	default y
	help
	  Qualcomm WCD (Wideband Codec) audio codec support.

config SND_SOC_QDSP6
	tristate "CAF QDSP6 audio transport"
	depends on SND_SOC_QCOM
	default y
	help
	  QDSP6 audio transport layer for CAF audio.

endmenu # CAF Audio

# ---------------------------------------------------------------
# CAF Camera subsystem
# ---------------------------------------------------------------

menu "CAF Camera"

config CAMSS_QCOM
	bool "CAF Qualcomm Camera Subsystem (CAMSS)"
	depends on ARCH_QCOM_CAF && VIDEO_DEV && MEDIA_CAMERA_SUPPORT
	select QCOM_CAMSS
	help
	  CAF Camera Subsystem support for Qualcomm ISP and camera
	  modules on SM7435.

config QCOM_CAMSS
	bool "QCOM Camera Subsystem core"
	depends on CAMSS_QCOM
	default y
	help
	  Core CAF camera subsystem driver.

config QCOM_CAMERA_SENSOR
	bool "QCOM camera sensor drivers"
	depends on CAMSS_QCOM
	default y
	help
	  CAF camera sensor driver support for common Xiaomi sensors.

endmenu # CAF Camera

# ---------------------------------------------------------------
# CAF Display subsystem
# ---------------------------------------------------------------

menu "CAF Display"

config MSM_DISPLAY
	bool "CAF Qualcomm MSM Display support"
	depends on ARCH_QCOM_CAF && DRM
	select DRM_MSM
	select DRM_MSM_DPU
	select DRM_MSM_HDMI
	help
	  CAF display support for Qualcomm MSM display pipeline
	  including DPU (Display Processing Unit) and HDMI.

config DRM_MSM
	tristate "DRM MSM display driver"
	depends on MSM_DISPLAY
	default y
	help
	  Direct Rendering Manager driver for Qualcomm MSM displays.

config DRM_MSM_DPU
	bool "DRM MSM DPU (Display Processing Unit)"
	depends on DRM_MSM
	default y
	help
	  DPU driver for Qualcomm display processing.

config DRM_MSM_HDMI
	bool "DRM MSM HDMI"
	depends on DRM_MSM
	default n
	help
	  HDMI output support for Qualcomm displays.

endmenu # CAF Display

