# Xiaomi Redmi Pad Pro (ruan), on top of gki_defconfig and parrot_GKI.config.
# Board drivers taken from the stock OS3.0 module list.

# Platform
CONFIG_ARCH_PARROT=y
# CONFIG_ARCH_RAVELIN is not set

# Display (LCD bias)
CONFIG_REGULATOR_QPNP_LCDB=m

# LEDs
CONFIG_LEDS_AW2016=m

# MTD (mtdoops on the stock partition layout)
CONFIG_MTD=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_OOPS=m

# SKU
CONFIG_BOOTCONFIG_HWC_IS_PRODUCT_SKU=y

# SPSS
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Battery charger (ruan firmware property layout)
CONFIG_QTI_BATTERY_CHARGER_RUAN=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m

# Touchscreen (Novatek NT36532 SPI, Xiaomi touch helpers)
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=m
CONFIG_TOUCHSCREEN_COMMON=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# USB Networking
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m

# LocalVersion
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-ruan"

# Devtmpfs (enabled in the stock 5.10 kernel)
CONFIG_DEVTMPFS=y

# Compiler options
CONFIG_FRAME_WARN=4096
# CONFIG_WERROR is not set

CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
