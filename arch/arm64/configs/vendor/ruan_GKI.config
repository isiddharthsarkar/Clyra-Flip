# Xiaomi Redmi Pad Pro (ruan), on top of gki_defconfig and parrot_GKI.config.
# Board drivers taken from the stock OS3.0 module list.

# Platform
CONFIG_ARCH_PARROT=y
# CONFIG_ARCH_RAVELIN is not set

# Display (LCD bias)
CONFIG_REGULATOR_QPNP_LCDB=m

# LEDs
CONFIG_LEDS_AW2016=m

# MTD (mtdoops on the stock partition layout)
CONFIG_MTD=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_OOPS=m

# SKU
CONFIG_BOOTCONFIG_HWC_IS_PRODUCT_SKU=y

# KernelSU Next + KowSU + susfs
CONFIG_KERNEL_SU=y
CONFIG_KSU_NEXT=y
CONFIG_KOWSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_HIDE=y

# SELinux (Strict Enforcing mode)
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_DEVELOP is not set

# Module signature verification (disabled so stock OEM vendor_dlkm modules load cleanly)
# CONFIG_MODULE_SIG_FORCE is not set

# CAF / Qualcomm support (SM7435 / Code Aurora Forum) - FULL CAF
CONFIG_ARCH_QCOM_CAF=y

# === Shared Memory and IPC ===
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMEM_SDP=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GENI_SMEM_IPC=y

# === SPMI Power Management ===
CONFIG_QCOM_SPMI_PMIC=y
CONFIG_QCOM_SPMI_ADSP=y
CONFIG_QCOM_SPMI_PMIC_ARB=y
CONFIG_QCOM_SPMI_WRAPPER=y

# === PDC ===
CONFIG_QCOM_PDC=y

# === RPMH Power Management ===
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMH_ADSP=y
CONFIG_QCOM_RPMT=y
CONFIG_QCOM_RPMH_VS=y

# === CPR ===
CONFIG_QCOM_CPR=y

# === LLCC ===
CONFIG_QCOM_LLCC=y

# === QCOM Power ===
CONFIG_QCOM_POWER=y
CONFIG_QCOM_WATCHDOG=y

# === Clock Control ===
CONFIG_QCOM_CLOCK_OMNI_POCR=y
CONFIG_QCOM_CLOCK_RPMH_CXO=y
CONFIG_QCOM_CLOCK_VIBRATOR=y

# === Interconnect ===
CONFIG_QCOM_ICC_QCOM=y
CONFIG_QCOM_ICC_RPMH=y

# === GPIO and Pin Control ===
CONFIG_PINCTRL_QCOM=y
CONFIG_GPIO_QCOM=y

# === QUPV3 I2C ===
CONFIG_QCOM_QUPV3_I2C=y

# === USB PHYs (kept as modules, enabled at runtime) ===
CONFIG_QCOM_USB_HSIC_PHY=m
CONFIG_QCOM_USB_HS_PHY=m
CONFIG_QCOM_USB_SS_PHY=m

# === CAF Audio ===
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QCOM_ADSP=m
CONFIG_SND_SOC_QCOM_WCD=m
CONFIG_SND_SOC_QDSP6=m

# === CAF Camera ===
CONFIG_CAMSS_QCOM=m
CONFIG_QCOM_CAMSS=m
CONFIG_QCOM_CAMERA_SENSOR=m

# === CAF Display ===
CONFIG_MSM_DISPLAY=m
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=m
CONFIG_DRM_MSM_HDMI=m

# QCOM debug
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Battery charger (ruan firmware property layout)
CONFIG_QTI_BATTERY_CHARGER_RUAN=y

# SIM tray detection and battery authentication (Xiaomi)
CONFIG_SIMTRAY_STATUS=m
CONFIG_BATT_VERIFY=m

# Lid hall sensor
CONFIG_INPUT_XIAOMI_HALL=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m

# Touchscreen (Novatek NT36532 SPI, Xiaomi touch helpers)
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=m
CONFIG_TOUCHSCREEN_COMMON=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# Redmi / POCO Pen (active stylus)
CONFIG_INPUT_XIAOMI_PEN=m

# USB Networking
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m

# LocalVersion
# Keep LOCALVERSION_AUTO on: MODULE_SCMVERSION depends on it, and it adds
# a field to struct module, so turning it off breaks module_layout for
# every stock vendor module.
CONFIG_LOCALVERSION_AUTO=y
CONFIG_LOCALVERSION="-gki"

# Devtmpfs (enabled in the stock 5.10 kernel)
CONFIG_DEVTMPFS=y

# Compiler options
CONFIG_FRAME_WARN=4096
# CONFIG_WERROR is not set

CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y

# Keep HZ at 250: stock vendor modules have it compiled in.
CONFIG_HZ=250
