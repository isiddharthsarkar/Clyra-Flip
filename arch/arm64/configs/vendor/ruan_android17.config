# Xiaomi ruan (SM7435 5G) — Android 17 GKI layer
# Layered on top of: gki_defconfig + parrot_GKI.config + ruan_GKI.config
#
# Android 17 uses Generic Kernel Image (GKI) 4.0 with kernel 6.6.
# This fragment pins the config options required by the Android 17 GKI
# KMI (Kernel Module Interface) so vendor modules built for Android 17
# (including HyperOS and AOSP builds) remain loadable.

# GKI version marker
CONFIG_GKI_VERSION_MAJOR=4
CONFIG_GKI_VERSION_MINOR=0

# Android 17 GKI requires stable KMI and signed modules.
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y

# Android common kernel interfaces required by AOSP and HyperOS.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_VENDOR_HOOKS=y
CONFIG_ANDROID_DEBUG_SYMBOLS=y
CONFIG_ANDROID_DEBUG_KINFO=y
CONFIG_ANDROID_WRAPFD=y
CONFIG_ANDROID_RB=y
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_ANDROID_PMEM=y
CONFIG_ANDROID_ASHMEM=y

# Device-specific (ruan) options kept enabled for all Android builds.
# (already set in ruan_GKI.config)
CONFIG_QTI_BATTERY_CHARGER_RUAN=y
CONFIG_INPUT_XIAOMI_HALL=m
CONFIG_MI_THERMAL_INTERFACE=m

# NOTE: CONFIG_LOCALVERSION is set in ruan_GKI.config to "-gki" for KMI
# compatibility with stock vendor modules. Do not override it here.
