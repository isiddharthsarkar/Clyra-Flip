# Xiaomi Redmi Pad Pro WiFi / POCO Pad WiFi (dizi), on top of gki_defconfig and parrot_GKI.config.
# Board drivers taken from the stock OS3.0 module list.
# dizi shares the kernel with ruan (5G model); the only kernel-level difference
# is that dizi has no modem/GNSS/telephony hardware, so modem-only options are
# left as modules (or unset) and ruan-specific telemetry is omitted.

# Platform
CONFIG_ARCH_PARROT=y
# CONFIG_ARCH_RAVELIN is not set

# Display (LCD bias)
CONFIG_REGULATOR_QPNP_LCDB=m

# LEDs
CONFIG_LEDS_AW2016=m

# MTD (mtdoops on the stock partition layout)
CONFIG_MTD=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_OOPS=m

# SKU
CONFIG_BOOTCONFIG_HWC_IS_PRODUCT_SKU=y

# SPSS
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Battery charger (dizi firmware property layout)
CONFIG_QTI_BATTERY_CHARGER_RUAN=y

# SIM tray detection (not present on WiFi-only dizi, kept as module for compatibility)
CONFIG_SIMTRAY_STATUS=m
CONFIG_BATT_VERIFY=m

# Lid hall sensor
CONFIG_INPUT_XIAOMI_HALL=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m

# Touchscreen (Novatek NT36532 SPI, Xiaomi touch helpers)
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=m
CONFIG_TOUCHSCREEN_COMMON=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# Redmi / POCO Pen (active stylus)
CONFIG_INPUT_XIAOMI_PEN=m

# USB Networking
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m

# No modem/GNSS/telephony on WiFi-only dizi (kept as modules where the driver exists)

# LocalVersion
# Keep LOCALVERSION_AUTO on: MODULE_SCMVERSION depends on it, and it adds
# a field to struct module, so turning it off breaks module_layout for
# every stock vendor module.
CONFIG_LOCALVERSION_AUTO=y
CONFIG_LOCALVERSION="-gki"

# Devtmpfs (enabled in the stock 5.10 kernel)
CONFIG_DEVTMPFS=y

# Compiler options
CONFIG_FRAME_WARN=4096
# CONFIG_WERROR is not set

CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y

# Keep HZ at 250: stock vendor modules have it compiled in.
CONFIG_HZ=250
